    if (document.body.id === "page-user-edit") {
        var email = document.querySelector('input[name="email"]')?.value || "";
        var firstname = document.querySelector('input[name="firstname"]')?.value || "";
        var logoutLink = document.querySelector(
            'nav.navbar-moodle-main div#usernavigation div.usermenu-container div.usermenu div#user-action-menu a[href*="logout.php"], ' +
            'nav.navbar-moodle-main div#usernavigation div.usermenu-container div.usermenu div#user-action-menu a[href*="loginas.php"]'
        );
        var logoutUrl = logoutLink ? encodeURI(logoutLink.getAttribute("href")) : "#";
        if (firstname !== "" && email === "") {
            Modal.create({
                title: 'Acceso no permitido',
                body: '<strong>El usuario con el que está intentando acceder al Campus Virtual ULL no tiene disponible este servicio</strong>.<br><br>Si es usted estudiante, recuerde que NO podrá acceder con su DNI. Deberá utilizar su ALU.<br><br>Únicamente el Alumnado, PDI y PAS de la ULL pueden hacer uso de este servicio. Si pertenece a uno de estos grupos de usuarios y no puede acceder al Campus Virtual ULL, asegúrese que accede con su usuario ULL (puede recuperarlo en <a target="_blank" href="https://usuarios.ull.es/reenvio/">esta dirección</a>). Si persiste el problema póngase en contacto con la <a target="_blank" href="https://www.ull.es/servicios/unidad-para-la-docencia-virtual-udv/informacion/">Unidad para Docencia Virtual (UDV)</a>.<br><br>Rogamos disculpe las molestias.',
                footer: '<a target="_self" href="' + logoutUrl  + '"><button id="logout-btn" class="btn btn-danger">Cerrar sesión</button></a>',
                removeOnClose: true,
                show: true
            });
        }
    }

    setTimeout(function() {
        $("div#page-wrapper div#theme_boost-drawers-courseindex nav#courseindex div.courseindex-section").each(function() {
            if ($(this).find("a[data-for='section_title']").text().search(/^(\s|\n)+$/) == 0) {
                $( $(this) ).hide()
            }
        })
    }, 500);

    if ($("body#page-mod-quiz-mod.path-mod.path-mod-quiz.pagelayout-admin").find("fieldset#id_seb").length > 0) {
        const latestTemplateName = "Campus Virtual ULL - V2 - 20240408";
        const preconfiguredSeb = ($("select[name='seb_templateid'] option[selected]").length > 0);

        $("select[name='seb_templateid'] option").each(function() {
          if ($(this).html() === latestTemplateName) {
            $(this).show();
            if (!preconfiguredSeb) $(this).attr("selected", "selected");
          } else {
            $(this).hide();
          }
        });
    }
});
